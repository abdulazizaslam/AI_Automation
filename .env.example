# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Strongly recommended for all server-side database writes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App / callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000
CALL_COMPLETION_SECRET=replace-with-a-long-random-secret
# Optional override for non-browser reset requests. The app UI can reset safely from same-origin.
ALLOW_DB_RESET=false

# n8n (optional)
N8N_START_CALL_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Gemini / LiveKit voice agent
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Keep false for strict scripted wording. Set true only if you want Gemini to lightly paraphrase normal turns.
GEMINI_ALLOW_PARAPHRASE=false
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Optional premium TTS providers
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
